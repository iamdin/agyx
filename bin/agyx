#!/bin/sh
# shellcheck disable=SC3013 # -ef/-nt are POSIX.1-2024 ( omitted only in older ShellCheck < 0.10 )
# agyx: manage agy profiles (profile, doctor, uninstall); any other invocation launches agy
# through the shim. There is no setup step: everything else is automatic. See README.md.
die() { echo "agyx: $*" >&2; exit 1; }

usage="usage: agyx [--profile NAME] [agy args...]   launch agy as a profile
       agyx profile login NAME        create profile NAME and sign in (needs a terminal)
       agyx profile remove NAME       move profile NAME to the Trash (alias: rm)
       agyx profile default [NAME]    show or set the default profile
       agyx profile current           the profile a launch would use, and why
       agyx profile list              list profiles and their Google accounts
       agyx profile usage [NAME|--all] show quota (default profile if omitted)
       agyx doctor                    check the installation
       agyx uninstall                 remove agyx's data and configuration
       --json   machine-readable output (profile default|current|list|usage|remove, doctor)
       --yes    answer yes to confirmations (same as AGYX_ASSUME_YES=1)
       exit: 0 ok, 1 error, 2 usage, 3 not set up / no profile, 4 not logged in, 5 needs a human
       any other arguments go to agy; agy's own help: agyx --profile NAME --help
       per-command help: agyx profile usage --help"

# Help is strictly read-only: zero forks, zero disk access.
if [ $# -eq 1 ]; then
  case $1 in --help|-h|help) echo "$usage"; exit 0 ;; esac
fi

# find our own real location (follow symlinks, bounded, zero dirname/basename forks)
self=$0 _hops=0
while [ -L "$self" ]; do
  _hops=$((_hops + 1)); [ "$_hops" -le 40 ] || die "symlink loop: $0"
  l=$(readlink "$self") || die "cannot read symlink: $self"
  case $l in
    /*) self=$l ;;
    *) case $self in */*) self=${self%/*}/$l ;; *) self=$l ;; esac ;;
  esac
done
case $self in */*) _sdir=${self%/*}; _sbase=${self##*/} ;; *) _sdir=.; _sbase=$self ;; esac

# Fast-path passthrough: only management subcommands (matching agyx_subcommand in runtime/sync.sh)
# plus --version are handled here; everything else launches agy directly via the sibling shim.
case ${1-} in
  doctor|profile|uninstall|--version) ;;
  *) unset AGYX_RUNTIME; exec "${_sdir%/}/agy" "$@" ;;
esac

_pdir=$(cd "${_sdir:-/}" && pwd -P) || die "cannot resolve script directory"
me=${_pdir%/}/$_sbase
shim=${me%/*}/agy
runtime=$(cd "${_pdir%/}/../runtime" && pwd -P) || die "cannot resolve runtime directory"
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
agyx_init "$shim"

# Version is strictly read-only: never touch disk.
if [ "${1-}" = --version ]; then
  echo "agyx $AGYX_VERSION"
  agyx_find_real && _r=$AGYX_REAL || _r=''
  [ -n "$_r" ] && [ -x "$_r" ] && echo "agy $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$_r" --version 2>&1 | head -n 1)"
  exit 0
fi

tok=antigravity-cli/antigravity-oauth-token
sec=${AGYX_SECURITY:-/usr/bin/security} # AGYX_SECURITY is only for tests
repair() { agyx_ensure_entry || die "cannot prepare app entry"; }
# JSON string, or null for an empty value. Names are validated and emails have no spaces.
jstr() { if [ -z "$1" ]; then printf null; else printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"; fi; }
jbool() { if "$@"; then printf true; else printf false; fi; }
# fail EXIT CODE MESSAGE [HINT]: stderr for people; with --json also an error object on stdout.
fail() {
  echo "agyx: $3" >&2
  [ -z "${4-}" ] || echo "hint: $4" >&2
  [ "${json-0}" != 1 ] || printf '{"ok":false,"error":{"code":%s,"message":%s,"hint":%s}}\n' "$(jstr "$2")" "$(jstr "$3")" "$(jstr "${4-}")"
  exit "$1"
}
die() { fail 1 error "$*"; }
notyet() { fail 3 not_set_up "agyx is not set up yet" "run agyx once in a terminal (or set AGYX_ASSUME_YES=1)"; }

need() { agyx_check_name "${1-}" || bad "$AGYX_ERR_MSG"; }
exists() {
  agyx_check_profile "${1-}" && return 0
  _rc=$?
  [ "$_rc" -eq 2 ] && bad "$AGYX_ERR_MSG"
  fail "$_rc" "$AGYX_ERR_CODE" "$AGYX_ERR_MSG" "$AGYX_ERR_HINT"
}
names() { for d in "$AGYX_DATA"/profiles/*/; do [ -d "$d" ] && basename "$d"; done; }
dflt() { [ -f "$AGYX_DATA/default" ] && cat "$AGYX_DATA/default"; }
# Saved email only: never open the token, even for metadata.
email_of() {
  e=''
  [ ! -f "$AGYX_DATA/profiles/$1/email" ] || IFS= read -r e < "$AGYX_DATA/profiles/$1/email"
  case $e in *[[:space:]]*) e='' ;; esac
  printf '%s' "$e"
}
logged_in() { [ -f "$AGYX_DATA/profiles/$1/$tok" ] && [ ! -L "$AGYX_DATA/profiles/$1/$tok" ]; }
status() {
  if ! logged_in "$1"; then echo "not logged in"; return 0; fi
  e=$(email_of "$1")
  echo "${e:-logged in, email unknown}"
}
dup_warning() {
  for n in $(names); do logged_in "$n" || continue; e=$(email_of "$n"); [ -n "$e" ] && echo "$e $n"; done | awk '
    { c[$1]++; p[$1] = p[$1] " " $2 }
    END { for (e in c) if (c[e] > 1) print "WARNING: profiles" p[e] " are logged in to the same Google account (" e ")" }'
}

bad() { [ "${json-0}" != 1 ] || fail 2 usage "$*"; echo "agyx: $*" >&2; echo "$usage" >&2; exit 2; }
# The profile a launch would pick without --profile: AGYX_PROFILE, then the saved default.
resolve() {
  agyx_resolve_profile || fail $? "$AGYX_ERR_CODE" "$AGYX_ERR_MSG" "$AGYX_ERR_HINT"
  rname=$AGYX_PROFILE_NAME rsrc=$AGYX_PROFILE_SRC
}
help_for() {
  case $1 in
    login) echo "usage: agyx profile login NAME
Create profile NAME and run agy's own sign-in (browser). A person must do this step.
exit: 0 signed in, 2 bad name, 5 no terminal" ;;
    remove|rm) echo "usage: agyx profile remove NAME [--yes] [--json]
Move profile NAME to the Trash (alias: rm). Asks first; without a terminal needs --yes.
json: {\"removed\":\"personal\",\"default\":\"work\"}
exit: 0 removed, 1 error or busy, 2 bad name, 3 not set up / no such profile, 5 no terminal and no --yes" ;;
    default) echo "usage: agyx profile default [NAME] [--json]
Without NAME, print the default profile. With NAME, set it.
json: {\"default\":\"work\"}
exit: 0 ok, 3 no default / no such profile" ;;
    current) echo "usage: agyx profile current [--json]
Print the profile a launch without --profile would use (AGYX_PROFILE, then the default).
json: {\"name\":\"work\",\"source\":\"env|default\",\"email\":\"a@b.c\",\"logged_in\":true}
exit: 0 ok, 3 none selected or it does not exist" ;;
    list) echo "usage: agyx profile list [--json]
List profiles. An empty list is not an error (stdout empty, hint on stderr).
json: {\"default\":\"work\",\"profiles\":[{\"name\":\"work\",\"email\":\"a@b.c\",\"logged_in\":true,\"default\":true}]}
exit: 0" ;;
    usage) echo "usage: agyx profile usage [NAME|--all] [--json]
Quota via agy's /usage: the current profile, NAME, or every logged-in profile in parallel (--all).
text: one line per limit: [PROFILE<TAB>]GROUP<TAB>LABEL<TAB>REMAINING%<TAB>RESET (PROFILE column only with --all)
json: [{\"profile\":\"work\",\"ok\":true,\"limits\":[{\"group\":\"Gemini Models\",\"window\":\"5h|weekly\",\"remaining\":92,\"resets_at\":\"2026-11-16T16:11:52Z\"}]}]
       a profile that could not be read: {\"profile\":\"x\",\"ok\":false,\"error\":\"not_logged_in|...\"}
exit: 0 ok, 1 an agy run failed, 3 no such profile, 4 not logged in (single profile)" ;;
    doctor) echo "usage: agyx doctor [--json]
Check the installation, profiles, permissions, shared links and token storage.
json: {\"ok\":false,\"issues\":[\"...\"],\"report\":[\"...\"]}
exit: 0 healthy, 1 issues found, 3 not set up" ;;
    uninstall) echo "usage: agyx uninstall [--yes]
Move agyx's data to the Trash and remove agyx. Asks first; without a terminal needs --yes.
exit: 0 removed, 1 refused or failed, 5 no terminal and no --yes" ;;
    *) echo "$usage" ;;
  esac
}

cmd=${1-}; [ $# -gt 0 ] && shift
# Our own flags may appear anywhere after the subcommand.
json=0 want_help=0 n=$#
while [ "$n" -gt 0 ]; do
  a=$1; shift; n=$((n - 1))
  case $a in
    --json) json=1 ;;
    --yes|-y) AGYX_ASSUME_YES=1; export AGYX_ASSUME_YES ;;
    --help|-h) want_help=1 ;;
    *) set -- "$@" "$a" ;;
  esac
done
if [ "$want_help" = 1 ]; then
  if [ "$cmd" = profile ]; then help_for "${1-}"; else help_for "$cmd"; fi
  exit 0
fi
if [ "$cmd" != uninstall ] && [ -d "$AGYX_DATA" ]; then
  repair
fi
case $cmd in
  profile)
    sub=${1-}; [ $# -gt 0 ] && shift
    case $sub in
      login)
        [ $# -eq 1 ] || bad "profile login needs exactly one profile name"
        need "${1-}"
        agyx_has_tty || fail 5 needs_terminal "profile login runs agy's interactive sign-in and needs a terminal" "ask the user to run: agyx profile login $1"
        agyx_gate; repair
        [ ! -L "$AGYX_DATA/profiles/$1" ] && [ ! -L "$AGYX_DATA/profiles/$1/antigravity-cli" ] || die "profile must not be a symlink"
        (umask 077; mkdir -p "$AGYX_DATA/profiles/$1/antigravity-cli") || die "cannot create profile"
        if logged_in "$1"; then
          echo "agyx: profile '$1' is already logged in ($(status "$1")). Starting agy in it anyway; sign in again from there only if you want to change the account." >&2
        fi
        login_log=$(mktemp "${TMPDIR:-/tmp}/agyx-login-XXXXXX") || die "cannot create temporary login log"
        trap 'rm -f "$login_log"' EXIT
        trap 'rm -f "$login_log"; exit 143' TERM
        trap 'rm -f "$login_log"; exit 129' HUP
        trap : INT
        (unset AGYX_RUNTIME; "$shim" --profile "$1" --log-file "$login_log"); rc=$?
        trap 'rm -f "$login_log"; exit 130' INT
        [ ! -s "$login_log" ] || agyx_check_storage "$login_log"
        if logged_in "$1"; then
          e=$(agyx_email_file "$login_log")
          if [ -n "$e" ]; then printf '%s\n' "$e" > "$AGYX_DATA/profiles/$1/email"
          else rm -f "$AGYX_DATA/profiles/$1/email"; fi
        fi
        rm -f "$login_log"
        if logged_in "$1" && [ -z "$(dflt)" ]; then
          printf '%s\n' "$1" > "$AGYX_DATA/default" &&
            echo "agyx: '$1' is now the default profile (change it with: agyx profile default NAME)" >&2
        fi
        exit "$rc"
        ;;
      default)
        [ $# -le 1 ] || bad "profile default takes at most one profile name"
        if [ $# -eq 0 ]; then
          [ -d "$AGYX_DATA" ] || notyet
          d=$(dflt)
          [ -n "$d" ] || fail 3 no_default "no default profile" "agyx profile default NAME"
          if [ "$json" = 1 ]; then printf '{"default":%s}\n' "$(jstr "$d")"; else echo "$d"; fi
          exit 0
        fi
        need "$1"
        [ -d "$AGYX_DATA" ] || notyet
        exists "$1"
        printf '%s\n' "$1" > "$AGYX_DATA/default" || die "cannot write $AGYX_DATA/default"
        [ "$json" != 1 ] || printf '{"default":%s}\n' "$(jstr "$1")"
        ;;
      list)
        [ $# -eq 0 ] || bad "profile list takes no arguments"
        d=''; [ ! -d "$AGYX_DATA" ] || d=$(dflt)
        all=''; [ ! -d "$AGYX_DATA" ] || all=$(names)
        [ -n "$all" ] || echo "agyx: no profiles yet; run: agyx profile login NAME" >&2
        if [ "$json" = 1 ]; then
          printf '{"default":%s,"profiles":[' "$(jstr "$d")"; sep=''
          for n in $all; do
            printf '%s{"name":%s,"email":%s,"logged_in":%s,"default":%s}' "$sep" "$(jstr "$n")" "$(jstr "$(email_of "$n")")" "$(jbool logged_in "$n")" "$(jbool [ "$n" = "$d" ])"
            sep=,
          done
          printf ']}\n'
        else
          for n in $all; do
            s=$(status "$n"); [ "$n" = "$d" ] && s="$s  (default)"
            printf '%-12s %s\n' "$n" "$s"
          done
        fi
        [ -z "$all" ] || dup_warning >&2
        ;;
      current)
        [ $# -eq 0 ] || bad "profile current takes no arguments"
        [ -d "$AGYX_DATA" ] || notyet
        resolve
        if [ "$json" = 1 ]; then
          printf '{"name":%s,"source":%s,"email":%s,"logged_in":%s}\n' "$(jstr "$rname")" "$(jstr "$rsrc")" "$(jstr "$(email_of "$rname")")" "$(jbool logged_in "$rname")"
        else
          echo "$rname"
        fi
        ;;
      usage)
        all=0; [ "${1-}" != --all ] || { all=1; shift; }
        [ $# -le $((1 - all)) ] || bad "profile usage takes one profile name or --all"
        [ -d "$AGYX_DATA" ] || notyet
        if [ "$all" = 1 ]; then
          picked=$(names)
          [ -n "$picked" ] || fail 3 no_profile "no profiles yet" "agyx profile login NAME"
        else
          if [ $# -eq 1 ]; then exists "$1"; rname=$1; else resolve; fi
          logged_in "$rname" || fail 4 not_logged_in "profile '$rname' is not logged in" "ask the user to run: agyx profile login $rname"
          picked=$rname
          if [ "$json" = 0 ]; then unset AGYX_RUNTIME; exec "$shim" --profile "$rname" -p /usage; fi
        fi
        # ponytail: one full agy start per profile (~10 s), run in parallel; a direct quota API would be faster but private.
        ut=$(mktemp -d "${TMPDIR:-/tmp}/agyx-usage-XXXXXX") || die "cannot create temporary directory"
        trap 'rm -rf "$ut"' EXIT
        trap 'rm -rf "$ut"; exit 130' INT
        trap 'rm -rf "$ut"; exit 143' TERM
        trap 'rm -rf "$ut"; exit 129' HUP
        for n in $picked; do
          logged_in "$n" || continue
          (unset AGYX_RUNTIME; "$shim" --profile "$n" -p /usage </dev/null >"$ut/$n.out" 2>"$ut/$n.err"; echo $? >"$ut/$n.rc") &
        done
        wait
        rc=0
        [ "$json" = 0 ] || printf '['
        sep=''
        for n in $picked; do
          if ! logged_in "$n"; then
            if [ "$json" = 1 ]; then printf '%s{"profile":%s,"ok":false,"error":"not_logged_in"}' "$sep" "$(jstr "$n")"
            else echo "agyx: $n: not logged in" >&2; fi
          elif [ "$(cat "$ut/$n.rc")" != 0 ]; then
            rc=1; e=$(cat "$ut/$n.err" "$ut/$n.out" | grep -v '^$' | head -n 1)
            if [ "$json" = 1 ]; then printf '%s{"profile":%s,"ok":false,"error":%s}' "$sep" "$(jstr "$n")" "$(jstr "${e:-agy exited with status $(cat "$ut/$n.rc")}")"
            else echo "agyx: $n: usage failed: ${e:-agy exited with status $(cat "$ut/$n.rc")}" >&2; fi
          elif ! awk -F '\t' 'NF == 4 && $3 ~ /^[0-9]+%$/ { ok = 1; exit } END { exit !ok }' "$ut/$n.out"; then
            rc=1; e=$(cat "$ut/$n.err" "$ut/$n.out" | grep -v '^$' | head -n 1)
            if [ "$json" = 1 ]; then printf '%s{"profile":%s,"ok":false,"error":%s}' "$sep" "$(jstr "$n")" "$(jstr "${e:-unrecognized /usage output}")"
            else echo "agyx: $n: usage failed: ${e:-unrecognized /usage output}" >&2; fi
          elif [ "$json" = 1 ]; then
            printf '%s{"profile":%s,"ok":true,"limits":[' "$sep" "$(jstr "$n")"
            awk -F '\t' 'function j(s) { gsub(/[\\"]/, "\\\\&", s); return "\"" s "\"" }
              NF == 4 && $3 ~ /^[0-9]+%$/ {
                w = $2; if (w ~ /^Five Hour/) w = "5h"; else if (w ~ /^Weekly/) w = "weekly"
                printf "%s{\"group\":%s,\"window\":%s,\"remaining\":%d,\"resets_at\":%s}", s, j($1), j(w), $3 + 0, j($4); s = ","
              }' "$ut/$n.out"
            printf ']}'
          else
            awk -F '\t' -v p="$n" 'NF == 4 && $3 ~ /^[0-9]+%$/ { print p "\t" $0 }' "$ut/$n.out"
          fi
          sep=,
        done
        [ "$json" = 0 ] || printf ']\n'
        exit "$rc"
        ;;
      remove|rm)
        [ $# -eq 1 ] || bad "profile remove needs exactly one profile name"
        pname=$1
        need "$pname"
        [ -d "$AGYX_DATA" ] || notyet
        exists "$pname"
        if [ "${AGYX_ASSUME_YES-}" != 1 ] && ! agyx_has_tty; then
          fail 5 needs_terminal "profile remove needs a terminal to ask; nothing was removed" "agyx profile remove $pname --yes"
        fi
        pids=$(agyx_profile_pids "$AGYX_DATA/profiles/$pname/antigravity-cli")
        if [ -n "$pids" ]; then
          fail 1 profile_busy "agy is still running in profile '$pname' (PIDs: ${pids% }). Close it first; nothing was removed"
        fi
        d=$(dflt)
        dnote=''; [ "$pname" != "$d" ] || dnote=', current default'
        {
          echo "agyx profile remove will move to Trash:"
          echo "  $(agyx_tilde "$AGYX_DATA/profiles/$pname")/   ($(status "$pname")$dnote)"
          echo "Kept: ~/.gemini (shared conversations and history) and other profiles."
        } >&2
        agyx_ask n "Remove profile '$pname'? [y/N] " || { echo >&2; die "nothing was removed."; }
        tbase=$(agyx_trash_base)
        (umask 077; mkdir -p "$tbase") || die "cannot create Trash directory"
        trash=$(mktemp -d "$tbase/agyx-profile-$pname-$(date +%Y%m%d%H%M%S)-XXXXXX") || die "cannot create profile Trash directory"
        mv "$AGYX_DATA/profiles/$pname" "$trash/$pname" || die "could not move $AGYX_DATA/profiles/$pname to the Trash"
        if [ "$pname" = "$d" ]; then
          rem=$(names)
          # shellcheck disable=SC2086 # validated profile names have no spaces or glob chars
          set -- $rem
          if [ $# -eq 1 ]; then
            printf '%s\n' "$1" > "$AGYX_DATA/default" || die "cannot write $AGYX_DATA/default"
            echo "agyx: '$1' is now the default profile (change it with: agyx profile default NAME)" >&2
          elif [ $# -eq 0 ]; then
            rm -f "$AGYX_DATA/default"
          else
            rm -f "$AGYX_DATA/default"
            echo "agyx: default profile cleared; set one with: agyx profile default NAME" >&2
          fi
        fi
        echo "agyx: removed profile '$pname' (moved to the Trash: $(agyx_tilde "$trash"))" >&2
        [ "$json" != 1 ] || printf '{"removed":%s,"default":%s}\n' "$(jstr "$pname")" "$(jstr "$(dflt)")"
        ;;
      *) bad "profile needs a subcommand: list | current | login NAME | remove NAME | default [NAME] | usage [NAME|--all]" ;;
    esac
    ;;
  uninstall)
    [ $# -eq 0 ] || bad "uninstall takes no arguments"
    if [ "${AGYX_ASSUME_YES-}" != 1 ] && ! agyx_has_tty; then
      fail 5 needs_terminal "uninstall needs a terminal to ask; nothing was removed" "agyx uninstall --yes"
    fi
    # Only check open non-symlink private targets inside agyx profiles (never block plain native agy).
    pids=$(agyx_profile_pids "$AGYX_DATA"/profiles/*/antigravity-cli)
    if [ -n "$pids" ]; then
      die "agy is still running (PIDs: ${pids% }). Close it first, then run agyx uninstall again; nothing was removed."
    fi
    pl=''; for n in $(names); do pl="$pl${pl:+, }$n"; done
    kind=other
    prefix=${me%/*/*}
    case $me in */Cellar/*/*) formula=${me#*/Cellar/}; formula=${formula%%/*}; kind=brew ;;
      *)
        if [ -e "$prefix/.git" ]; then kind=checkout
        elif [ -f "$prefix/.agyx-prefix" ]; then kind=prefix
        fi ;;
    esac
    plink=$AGYX_HOME/.local/bin/agyx
    case $kind in
      checkout|prefix) [ -L "$plink" ] && [ "$plink" -ef "$me" ] || plink= ;;
    esac
    {
      echo "agyx uninstall will remove:"
      [ -d "$AGYX_DATA" ] && echo "  $(agyx_tilde "$AGYX_DATA")/   profiles ${pl:-none} (private app files, logins and logs; moved to Trash)"
      case $kind in
        brew) echo "  agyx itself   (brew uninstall $formula)" ;;
        checkout) if [ -n "$plink" ]; then echo "  agyx itself   (the link $(agyx_tilde "$plink"))"; else echo "  agyx itself   (nothing: it runs from a checkout, which is left alone)"; fi ;;
        prefix)
          echo "  agyx itself   (the install $(agyx_tilde "$prefix"))"
          [ -z "$plink" ] || echo "  $(agyx_tilde "$plink")   PATH link"
          ;;
        *) echo "  agyx itself   (delete $(agyx_tilde "$me") yourself)" ;;
      esac
      echo "Kept: ~/.gemini (shared settings, history and conversations) and plain agy."
      [ -d "$AGYX_DATA" ] && echo "Apps set up with $(agyx_tilde "$AGYX_DATA")/agy will stop working."
    } >&2
    agyx_ask n 'Remove? [y/N] ' || { echo >&2; die "nothing was removed."; }
    tbase=$(agyx_trash_base)
    (umask 077; mkdir -p "$tbase") || die "cannot create Trash directory"
    trash=$(mktemp -d "$tbase/agyx-uninstall-$(date +%Y%m%d%H%M%S)-XXXXXX") || die "cannot create uninstall Trash directory"
    [ ! -d "$AGYX_DATA" ] || mv "$AGYX_DATA" "$trash/data" || die "could not move $AGYX_DATA to the Trash"
    echo "agyx: removed. Moved to the Trash: $(agyx_tilde "$trash")"
    case $kind in
      brew)
        echo "agyx: removing the program now (optionally afterwards: brew untap iamdin/tap)"
        exec brew uninstall "$formula" ;;
      checkout)
        if [ -n "$plink" ]; then rm -f "$plink" && echo "agyx: removed the link $(agyx_tilde "$plink") (the checkout is left alone)"
        else echo "agyx: nothing else to remove (agyx runs from a checkout, which is left alone)"; fi ;;
      prefix)
        [ -z "$plink" ] || rm -f "$plink"
        rm -rf "$prefix"
        echo "agyx: removed the install $(agyx_tilde "$prefix")${plink:+ and $(agyx_tilde "$plink")}"
        ;;
      *) echo "agyx: to finish, delete $me yourself" ;;
    esac
    ;;
  doctor)
    [ $# -eq 0 ] || bad "doctor takes no arguments"
    [ -d "$AGYX_DATA" ] || notyet
    ddir=$(mktemp -d "${TMPDIR:-/tmp}/agyx-doctor-XXXXXX") || die "cannot create temporary directory"
    trap 'rm -rf "$ddir"' EXIT
    trap 'rm -rf "$ddir"; exit 130' INT
    trap 'rm -rf "$ddir"; exit 143' TERM
    trap 'rm -rf "$ddir"; exit 129' HUP
    dr=$ddir/report de=$ddir/err di=$ddir/issues
    : > "$dr"; : > "$de"; : > "$di"
    doc_line() { printf '%s\n' "$1" >> "$dr"; }
    doc_warn() { printf '%s\n' "$1" >> "$dr"; printf '%s\n' "$1" >> "$di"; }
    doc_err_warn() { printf '%s\n' "$1" >> "$de"; printf '%s\n' "$1" >> "$di"; }

    doc_line "agyx version: $AGYX_VERSION"
    if agyx_find_real; then
      doc_line "real agy: $AGYX_REAL${AGYX_REAL_AGY:+ (from AGYX_REAL_AGY)}"
      doc_line "version: $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$AGYX_REAL" --version 2>&1 | head -n 1)"
      if ! _w=$(agyx_check_binary "$AGYX_REAL" 2>&1); then doc_err_warn "$_w"; fi
    else
      doc_warn "real agy: NOT FOUND. Install agy, or point agyx at it with AGYX_REAL_AGY=/path/to/agy"
    fi
    first=$(command -v agyx)
    if [ -n "$first" ] && [ "$first" -ef "$me" ]; then doc_line "PATH: agyx resolves to this script ($first)"
    else doc_warn "PATH: agyx does NOT resolve to this script (found: ${first:-none}); put it on PATH (Homebrew does; or link $me)"; fi
    if [ -e "$AGYX_DATA/agy" ] && [ "$AGYX_DATA/agy" -ef "$shim" ]; then
      doc_line "agy entry: $AGYX_DATA/agy (in place; the path to give apps that need a binary named agy)"
    else
      doc_warn "agy entry: $AGYX_DATA/agy is MISSING or not agyx's (it is the path to give apps that need a binary named agy)"
    fi
    if agyx_native_file_storage; then
      doc_line "profile mode: real HOME; native file storage (no shell bridge needed); --app_data_dir=<profile>/antigravity-cli (relative to ~/.gemini)"
    else
      doc_line "profile mode: real HOME; WSL_INTEROP=${WSL_INTEROP:-agyx} (desktop keyring bypass + shell bridge); --app_data_dir=<profile>/antigravity-cli (relative to ~/.gemini)"
    fi
    if [ -x "$sec" ] && HOME=$AGYX_HOME "$sec" find-generic-password -s gemini -a antigravity >/dev/null 2>&1; then
      doc_line "keychain: INFO plain agy has a login (gemini/antigravity); agyx does not use it"
    fi
    d=$(dflt); doc_line "default: ${d:-none}"
    # shellcheck disable=SC2034 # used by agyx_report in runtime/sync.sh
    AGYX_DOC_LINE=doc_line AGYX_DOC_WARN=doc_warn
    for n in $(names); do
      p=$AGYX_DATA/profiles/$n
      t=$p/$tok
      doc_line "profile $n: $(status "$n")"
      for dir in "$p" "$p/antigravity-cli"; do
        if [ -d "$dir" ]; then
          mode=$(agyx_mode "$dir")
          [ $((0$mode & 077)) -eq 0 ] || doc_warn "  permissions: WARNING $dir mode $mode is group/world accessible (expected 0700)"
        else doc_warn "  permissions: WARNING directory missing: $dir"; fi
      done
      if [ -L "$t" ]; then doc_warn "  token: WARNING symlink (profile will not start)"
      elif [ -f "$t" ]; then
        mode=$(agyx_mode "$t")
        if [ "$mode" = 600 ]; then doc_line "  token: present, mode 0600"
        else doc_warn "  token: WARNING mode $mode (expected 0600)"; fi
      else doc_line "  token: missing (sign in again)"; fi
      pdir=$p/antigravity-cli
      agyx_report "$pdir"
      nl=$(ls -t "$pdir"/log/*.log 2>/dev/null | head -n 1)
      if [ -n "$nl" ]; then
        if ! _w=$(agyx_check_storage "$nl" 2>&1); then doc_err_warn "$_w"; fi
      fi
      nl=${nl##*/}
      doc_line "  logs: $(agyx_tilde "$pdir/log")/, newest: ${nl:-none yet}"
    done
    unset AGYX_DOC_LINE AGYX_DOC_WARN
    _dups=$(dup_warning)
    if [ -n "$_dups" ]; then
      printf '%s\n' "$_dups" | while IFS= read -r _dl; do
        [ -z "$_dl" ] || doc_warn "$_dl"
      done
    fi
    if [ "$json" = 1 ]; then
      jarr() { awk 'function j(s) { gsub(/[\\"]/, "\\\\&", s); gsub(/\t/, " ", s); return "\"" s "\"" } NF { printf "%s%s", c, j($0); c = "," }'; }
      printf '{"ok":%s,"issues":[%s],"report":[%s]}\n' "$(jbool [ ! -s "$di" ])" "$(jarr < "$di")" "$(cat "$dr" "$de" | jarr)"
    else
      cat "$dr"
      [ ! -s "$de" ] || cat "$de" >&2
    fi
    _has_issues=0; [ ! -s "$di" ] || _has_issues=1
    rm -rf "$ddir"
    [ "$_has_issues" = 0 ] || exit 1
    ;;
esac

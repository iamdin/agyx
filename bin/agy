#!/bin/sh
# agyx shim: run agy with real HOME and a private file login.
die() { echo "agyx: $*" >&2; exit 1; }
usage_err() { echo "agyx: $*" >&2; exit 2; }
missing_err() { echo "agyx: $*" >&2; exit 3; }

# find our own real location (follow symlinks, bounded, zero dirname/basename forks)
self=$0 _hops=0
while [ -L "$self" ]; do
  _hops=$((_hops + 1)); [ "$_hops" -le 40 ] || die "symlink loop: $0"
  l=$(readlink "$self") || die "cannot read symlink: $self"
  case $l in
    /*) self=$l ;;
    *) case $self in */*) self=${self%/*}/$l ;; *) self=$l ;; esac ;;
  esac
done
case $self in */*) _sdir=${self%/*}; _sbase=${self##*/} ;; *) _sdir=.; _sbase=$self ;; esac
_pdir=$(cd "${_sdir:-/}" && pwd -P) || die "cannot resolve script directory"
self=${_pdir%/}/$_sbase
runtime=$(cd "${_pdir%/}/../runtime" && pwd -P) || die "cannot resolve runtime directory"
rh=$HOME
unset AGYX_REAL_HOME AGY_PROFILE
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
# shellcheck disable=SC2034 # R, AGYX_SHIM, AGYX_RUNTIME and data are used by sync.sh
R=$rh AGYX_SHIM=$self AGYX_RUNTIME=$runtime
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
# what we store or pass on (entry link, ZDOTDIR, BASH_ENV) must survive a Homebrew upgrade
agyx_stable "$self"; AGYX_SHIM=$AGYX_STABLE
runtime_stable=${AGYX_SHIM%/*/*}/runtime
# ask once before the first write; then automatic repairs (stderr only, never stdout)
agyx_gate
agyx_ensure_entry || die "cannot prepare app entry"

# 1. profile choice: leading --profile flags only
flag=0 name='' src=''
while [ $# -gt 0 ]; do
  case $1 in
    --profile)
      [ $# -ge 2 ] || usage_err "--profile needs a value"
      v=$2; shift 2 ;;
    --profile=*) v=${1#--profile=}; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
  [ "$flag" = 0 ] || usage_err "--profile given more than once"
  [ -n "$v" ] || usage_err "--profile value is empty"
  flag=1 name=$v
done
if [ "$flag" = 0 ]; then
  name=${AGYX_PROFILE:-}
  [ -z "$name" ] || src='env'
  if [ -z "$name" ] && [ -f "$data/default" ]; then
    read -r name < "$data/default" || :
    [ -z "$name" ] || src='default'
  fi
  if [ -z "$name" ]; then
    existing=''
    for d in "$data"/profiles/*/; do [ -d "$d" ] && existing="$existing $(basename "$d")"; done
    if [ -z "$existing" ]; then
      missing_err "no profiles yet. Create and sign in to one with: agyx profile login NAME (for example: agyx profile login work)"
    fi
    missing_err "no profile chosen. Existing profiles:$existing. Pick one with --profile NAME, or set a default with: agyx profile default NAME"
  fi
fi
agyx_valid_name "$name" || usage_err "invalid profile name: $name"
agyx_subcommand "$name" && usage_err "profile name is reserved: $name"
P=$data/profiles/$name/antigravity-cli
if [ -L "$data/profiles/$name" ] || [ -L "$P" ]; then
  die "profile '$name' must not be a symlink"
fi
if [ ! -d "$P" ]; then
  if [ "$src" = default ]; then
    missing_err "the default profile '$name' (from $data/default) does not exist. Fix it with: agyx profile default NAME, or create it with: agyx profile login $name"
  fi
  missing_err "profile '$name' does not exist (run: agyx profile login $name)"
fi

# 2. real binary & profile app preparation
agyx_find_real || agyx_missing_agy
for a in "$@"; do
  case $a in --app_data_dir|--app_data_dir=*|-app_data_dir|-app_data_dir=*|--gemini_dir|--gemini_dir=*|-gemini_dir|-gemini_dir=*) usage_err "storage flags are managed by agyx" ;; esac
done
agyx_sync_app || {
  _rc=$?
  [ "$_rc" -eq 5 ] && exit 5
  die "cannot prepare profile app directory"
}
agyx_app_arg || die "cannot resolve profile app directory"

# 3. per-platform keyring bypass:
# - Headless Linux, containers, and SSH sessions already use file storage natively (zero env/shell hooks).
# - Desktop sessions with an active OS keyring (local macOS, Linux Desktop with D-Bus) set WSL_INTEROP
#   (ignored by brew/CLI tools unlike WSL_DISTRO_NAME) and clean it on first shell entry.
AGYX_PROFILE=$name AGY_CLI_DISABLE_AUTO_UPDATE=true
export AGYX_PROFILE AGY_CLI_DISABLE_AUTO_UPDATE
if ! agyx_native_file_storage; then
  bz=$runtime_stable/zsh bb=$runtime_stable/bash_env
  if [ "${ZDOTDIR-}" != "$bz" ] && [ "${BASH_ENV-}" != "$bb" ]; then
    AGYX_ORIG_WSL_INTEROP=${WSL_INTEROP+:$WSL_INTEROP}
  fi
  [ "${ZDOTDIR-}" = "$bz" ] || AGYX_ORIG_ZDOTDIR=${ZDOTDIR+:$ZDOTDIR}
  [ "${BASH_ENV-}" = "$bb" ] || AGYX_ORIG_BASH_ENV=${BASH_ENV+:$BASH_ENV}
  WSL_INTEROP=${WSL_INTEROP:-agyx} ZDOTDIR=$bz BASH_ENV=$bb
  export WSL_INTEROP AGYX_ORIG_WSL_INTEROP AGYX_ORIG_ZDOTDIR AGYX_ORIG_BASH_ENV ZDOTDIR BASH_ENV
fi

# 4. check newest native log in <profile>/antigravity-cli/log, then direct exec
agyx_check_recent_log "$P"
unset AGYX_RUNTIME AGYX_ASSUME_YES AGYX_TTY AGYX_SECURITY AGYX_TRASH_DIR AGYX_LOCK_TRIES AGYX_OS AGYX_DOCKERENV
# shellcheck disable=SC2154 # real is set by agyx_find_real
exec "$real" "--app_data_dir=$AGYX_APP_ARG" "$@"

#!/bin/sh
# agyx shim: run agy with real HOME and a private file login.
die() { echo "agyx: $*" >&2; exit 2; }

# find our own real location (follow symlinks, bounded) so runtime/ is found wherever installed
self=$0 _hops=0
while [ -L "$self" ]; do
  _hops=$((_hops + 1)); [ "$_hops" -le 40 ] || die "symlink loop: $0"
  l=$(readlink "$self") || die "cannot read symlink: $self"
  case $l in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
self=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")
runtime=$(cd "$(dirname "$self")/../runtime" && pwd -P)
rh=$HOME
unset AGYX_REAL_HOME AGY_PROFILE
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
# shellcheck disable=SC2034 # R, AGYX_SHIM, AGYX_RUNTIME and data are used by sync.sh
R=$rh AGYX_SHIM=$self AGYX_RUNTIME=$runtime
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
# what we store or pass on (entry link, ZDOTDIR, BASH_ENV) must survive a Homebrew upgrade
agyx_stable "$self"; AGYX_SHIM=$AGYX_STABLE
runtime_stable=${AGYX_SHIM%/*/*}/runtime
# ask once before the first write; then automatic repairs (stderr only, never stdout)
agyx_gate
agyx_migrate
agyx_ensure_entry || die "cannot prepare app entry"

# 1. profile choice: leading --profile flags only
flag=0 name='' src=''
while [ $# -gt 0 ]; do
  case $1 in
    --profile)
      [ $# -ge 2 ] || die "--profile needs a value"
      v=$2; shift 2 ;;
    --profile=*) v=${1#--profile=}; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
  [ "$flag" = 0 ] || die "--profile given more than once"
  [ -n "$v" ] || die "--profile value is empty"
  flag=1 name=$v
done
if [ "$flag" = 0 ]; then
  name=${AGYX_PROFILE:-}
  [ -z "$name" ] || src='env'
  if [ -z "$name" ] && [ -f "$data/default" ]; then
    read -r name < "$data/default" || :
    [ -z "$name" ] || src='default'
  fi
  if [ -z "$name" ]; then
    existing=''
    for d in "$data"/profiles/*/; do [ -d "$d" ] && existing="$existing $(basename "$d")"; done
    if [ -z "$existing" ]; then
      die "no profiles yet. Create and sign in to one with: agyx profile login NAME (for example: agyx profile login work)"
    fi
    die "no profile chosen. Existing profiles:$existing. Pick one with --profile NAME, or set a default with: agyx profile default NAME"
  fi
fi
agyx_valid_name "$name" || die "invalid profile name: $name"
agyx_subcommand "$name" && die "profile name is reserved: $name"
P=$data/profiles/$name/antigravity-cli
if [ ! -d "$P" ] || [ -L "$P" ] || [ -L "$data/profiles/$name" ]; then
  if [ "$src" = default ]; then
    die "the default profile '$name' (from $data/default) does not exist. Fix it with: agyx profile default NAME, or create it with: agyx profile login $name"
  fi
  die "profile '$name' does not exist (run: agyx profile login $name)"
fi

# 2. real binary & profile app preparation
agyx_find_real || agyx_missing_agy
for a in "$@"; do
  case $a in --app_data_dir|--app_data_dir=*|-app_data_dir|-app_data_dir=*|--gemini_dir|--gemini_dir=*|-gemini_dir|-gemini_dir=*) die "storage flags are managed by agyx" ;; esac
done
agyx_sync_app || die "cannot prepare profile app directory"
agyx_app_arg || die "cannot resolve profile app directory"

# 3. environment (bijective :value encoding: empty = unset, :val = set to val; idempotent nested)
bz=$runtime_stable/zsh bb=$runtime_stable/bash_env
if [ "${ZDOTDIR-}" != "$bz" ] && [ "${BASH_ENV-}" != "$bb" ]; then
  AGYX_ORIG_WSL=${WSL_DISTRO_NAME+:$WSL_DISTRO_NAME}
fi
[ "${ZDOTDIR-}" = "$bz" ] || AGYX_ORIG_ZDOTDIR=${ZDOTDIR+:$ZDOTDIR}
[ "${BASH_ENV-}" = "$bb" ] || AGYX_ORIG_BASH_ENV=${BASH_ENV+:$BASH_ENV}
WSL_DISTRO_NAME=${WSL_DISTRO_NAME:-agyx} AGYX_PROFILE=$name AGY_CLI_DISABLE_AUTO_UPDATE=true
ZDOTDIR=$bz BASH_ENV=$bb
export WSL_DISTRO_NAME AGYX_ORIG_WSL AGYX_ORIG_ZDOTDIR AGYX_ORIG_BASH_ENV \
  AGYX_PROFILE AGY_CLI_DISABLE_AUTO_UPDATE ZDOTDIR BASH_ENV

# 4. pre-exec storage checks + per-launch log allocation, then direct exec (preserves PID & signals)
# shellcheck disable=SC2154 # real is set by agyx_find_real
agyx_check_binary "$real"
if agyx_wants_log "$@"; then
  agyx_check_recent_log "$data/profiles/$name"
  if agyx_new_log "$data/profiles/$name"; then
    set -- --log-file "$AGYX_LOGFILE" "$@"
  else
    echo "agyx: warning: could not create a log file in $data/profiles/$name/log; agy writes its default log" >&2
  fi
fi
unset AGYX_RUNTIME AGYX_ASSUME_YES AGYX_TTY AGYX_SECURITY AGYX_TRASH_DIR AGYX_LOG_STAMP AGYX_LOCK_TRIES
exec "$real" "--app_data_dir=$AGYX_APP_ARG" "$@"

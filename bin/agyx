#!/bin/sh
# agyx: manage agy profiles (profile, doctor); any other invocation launches agy through the
# shim. There is no setup step: everything else is automatic. See README.md.
die() { echo "agyx: $*" >&2; exit 1; }
valid() {
  case $1 in *'
'*) return 1 ;; esac
  printf %s "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$'
}
# find our own real location (follow symlinks, e.g. Homebrew's bin link) to locate the packaged shim
self=$0
while [ -L "$self" ]; do
  l=$(readlink "$self")
  case $l in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
me=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")
shim=${me%/*}/agy
rh=${AGYX_REAL_HOME:-$(eval "printf %s ~$(id -un)")}
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
# shellcheck disable=SC2034 # R and AGYX_SHIM are used by the functions in sync.sh
R=$rh AGYX_SHIM=$shim
# shellcheck source=../runtime/sync.sh
. "${me%/*}/../runtime/sync.sh"
agyx_stable "$shim"
# shellcheck disable=SC2034 # used by the functions in sync.sh
AGYX_SHIM=$AGYX_STABLE # the entry link must survive a Homebrew upgrade
usage="usage: agyx [--profile NAME] [agy args...]   launch agy as a profile
       agyx profile login NAME      create profile NAME and sign in with agy's own login
       agyx profile default [NAME]  show or set the default profile
       agyx profile list            list profiles and their Google accounts
       agyx doctor                  check the installation
       any other arguments go to agy; agy's own help: agyx --profile NAME --help"
# help: agyx's own usage (read-only; never asks, never writes, works before setup)
if [ $# -eq 1 ]; then
  case $1 in --help|-h|help) echo "$usage"; exit 0 ;; esac
fi
# --version: agyx's own version, then the real agy's when it can be found (writes nothing)
if [ "${1-}" = --version ]; then
  echo "agyx $AGYX_VERSION"
  # shellcheck disable=SC2154 # real and _found are set by agyx_find_real / agyx_scan_path
  if [ -d "$data" ]; then agyx_find_real && _r=$real || _r=
  elif [ -n "${AGYX_REAL_AGY-}" ]; then _r=$AGYX_REAL_AGY
  else agyx_scan_path && _r=$_found || _r=; fi
  [ -n "$_r" ] && [ -x "$_r" ] && echo "agy $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$_r" --version 2>&1 | head -n 1)"
  exit 0
fi
# Anything that is not one of our own subcommands launches agy (none of them overlaps with an
# agy subcommand or flag, including -h/--help). umask is untouched so agy inherits the caller's.
agyx_subcommand "${1-}" || exec "$shim" "$@"

tok=home/.gemini/antigravity-cli/antigravity-oauth-token
sec=${AGYX_SECURITY:-/usr/bin/security}  # AGYX_SECURITY is only for tests
# Nothing is written before the user agreed once (agyx_gate, for the commands that write); read-only
# commands report "not set up yet". Once set up, missing pieces are repaired silently.
repair() { agyx_ensure_entry; agyx_ensure_links_file; }
[ -d "$data" ] && repair
notyet() { echo "agyx is not set up yet; run agyx once in a terminal to set it up (or set AGYX_ASSUME_YES=1)"; exit 0; }

need() {
  valid "${1-}" || bad "invalid profile name: ${1-}"
  ! agyx_subcommand "$1" || bad "profile name is reserved: $1"
}
exists() { need "${1-}"; [ -d "$data/profiles/$1/home" ] || bad "no such profile: $1"; }
names() { for d in "$data"/profiles/*/; do [ -d "$d" ] && basename "$d"; done; }
dflt() { [ -f "$data/default" ] && cat "$data/default"; }
# Email of a profile: the one line in <profile>/email (written after a successful login); else the
# id_token_email field of a token file in the profile's own (not yet migrated) .gemini; else empty.
email_of() {
  e=
  [ -f "$data/profiles/$1/email" ] && IFS= read -r e < "$data/profiles/$1/email"
  case $e in ''|*[[:space:]]*)
    e=
    [ -L "$data/profiles/$1/home/.gemini" ] || e=$(agyx_email_token "$data/profiles/$1/$tok") ;;
  esac
  printf '%s' "$e"
}
# Does the profile keychain hold agy's login item? Never asks for the secret (no -w / -g).
kc_has_item() { agyx_kc_has_item "$1"; }
# Logged in = token file present or the profile keychain holds agy's login item.
logged_in() { { [ ! -L "$data/profiles/$1/home/.gemini" ] && [ -f "$data/profiles/$1/$tok" ]; } || kc_has_item "$1"; }
# The account email of a login that just finished: the last email= on an applyAuthResult line in the
# shared agy log files modified after the marker file $1 was written (older files are ignored).
login_email() {
  ld=$rh/.gemini/antigravity-cli/log
  le=
  lfl=$(find "$ld" -type f -newer "$1" 2>/dev/null)
  [ -n "$lfl" ] || return 0
  # shellcheck disable=SC2086,SC2045 # log file names contain no spaces or globbing characters
  for lf in $(ls -tr $lfl 2>/dev/null); do
    lx=$(grep applyAuthResult "$lf" 2>/dev/null | sed -n 's/.*email=\([^][ ,;"}()]*\).*/\1/p' | tail -n 1 | tr -d '[:cntrl:]')
    case $lx in ''|*[[:space:]]*) ;; *) le=$lx ;; esac
  done
  printf '%s' "$le"
}
status() {
  if ! logged_in "$1"; then echo "not logged in"; return 0; fi
  e=$(email_of "$1")
  echo "${e:-logged in, email unknown}"
}
kcstate() {
  kc=$data/profiles/$1/home/Library/Keychains/login.keychain-db
  [ -e "$kc" ] || { echo "keychain missing (created on next launch)"; return 0; }
  kd=$(HOME=$data/profiles/$1/home "$sec" default-keychain -d user 2>/dev/null | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
  if [ "$kd" = "$kc" ]; then echo "keychain ok (default for this profile)"; else echo "keychain NOT the default for this profile (found: ${kd:-none})"; fi
}
dup_warning() {
  for n in $(names); do e=$(email_of "$n"); [ -n "$e" ] && echo "$e $n"; done | awk '
    { c[$1]++; p[$1] = p[$1] " " $2 }
    END { for (e in c) if (c[e] > 1) print "WARNING: profiles" p[e] " are logged in to the same Google account (" e ")" }'
}

bad() { echo "agyx: $*" >&2; echo "$usage" >&2; exit 2; }

cmd=${1-}; [ $# -gt 0 ] && shift
case $cmd in
  profile)
    sub=${1-}; [ $# -gt 0 ] && shift
    case $sub in
      login)
        [ $# -eq 1 ] || bad "profile login needs exactly one profile name"
        need "${1-}"
        agyx_gate; repair
        (umask 077; mkdir -p "$data/profiles/$1/home") || die "cannot create profile"
        if logged_in "$1"; then
          echo "agyx: profile '$1' is already logged in ($(status "$1")). Starting agy in it anyway; sign in again from there only if you want to change the account." >&2
        fi
        # run agy as a child (not exec) to set the default afterwards; SIGINT reaches agy, not us
        # the shared agy logs are older than this marker unless they belong to this login
        mk=$data/profiles/$1/.login-start; : > "$mk"
        trap : INT
        "$shim" --profile "$1"; rc=$?
        trap - INT
        if logged_in "$1"; then
          e=$(login_email "$mk"); [ -z "$e" ] || printf '%s\n' "$e" > "$data/profiles/$1/email"
        fi
        rm -f "$mk"
        if logged_in "$1" && [ -z "$(dflt)" ]; then
          printf '%s\n' "$1" > "$data/default" &&
            echo "agyx: '$1' is now the default profile (change it with: agyx profile default NAME)"
        fi
        exit "$rc"
        ;;
      default)
        [ $# -le 1 ] || bad "profile default takes at most one profile name"
        if [ $# -eq 0 ]; then [ -d "$data" ] || notyet; d=$(dflt); echo "${d:-none}"; exit 0; fi
        need "$1"; agyx_gate; repair; exists "$1"
        printf '%s\n' "$1" > "$data/default"
        ;;
      list)
        [ $# -eq 0 ] || bad "profile list takes no arguments"
        [ -d "$data" ] || notyet
        if [ -z "$(names)" ]; then echo "no profiles yet; run: agyx profile login NAME"; exit 0; fi
        d=$(dflt)
        for n in $(names); do
          s=$(status "$n"); [ "$n" = "$d" ] && s="$s  (default)"
          printf '%-12s %s\n' "$n" "$s"
        done
        dup_warning
        ;;
      *) bad "profile needs a subcommand: list | login NAME | default [NAME]" ;;
    esac
    ;;
  doctor)
    [ $# -eq 0 ] || bad "doctor takes no arguments"
    echo "agyx version: $AGYX_VERSION"
    [ -d "$data" ] || notyet
    # shellcheck disable=SC2154 # real is set by agyx_find_real
    if agyx_find_real; then
      echo "real agy: $(readlink "$real" 2>/dev/null || echo "$real")${AGYX_REAL_AGY:+ (from AGYX_REAL_AGY)}"
      echo "version: $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$real" --version 2>&1 | head -n 1)"
    else
      echo "real agy: NOT FOUND. Install agy, or point agyx at it with AGYX_REAL_AGY=/path/to/agy"
    fi
    first=$(command -v agyx)
    if [ -n "$first" ] && [ "$first" -ef "$me" ]; then echo "PATH: agyx resolves to this script ($first)"
    else echo "PATH: agyx does NOT resolve to this script (found: ${first:-none}); put it on PATH (Homebrew does; or link $me)"; fi
    if [ -e "$data/bin/agy" ] && [ "$data/bin/agy" -ef "$shim" ]; then
      echo "agy entry: $data/bin/agy (in place; the path to give apps that need a binary named agy)"
    else
      echo "agy entry: $data/bin/agy is MISSING or not agyx's (it is the path to give apps that need a binary named agy)"
    fi
    kd=$(HOME=$rh "$sec" default-keychain -d user 2>/dev/null | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
    case $kd in
      "$data"/*) echo "keychain: WARNING the real default keychain is inside the agyx data dir ($kd)" ;;
      *) echo "keychain: real default keychain is ${kd:-unknown}, outside the agyx data dir" ;;
    esac
    agyx_blocker_state
    case $AGYX_BLOCKER_STATE in
      ok) echo "token blocker: ok ($(agyx_tilde "$AGYX_BLOCKER") is a directory)" ;;
      missing) echo "token blocker: missing (created on next launch): $(agyx_tilde "$AGYX_BLOCKER")" ;;
      *) echo "token blocker: BLOCKING: $(agyx_tilde "$AGYX_BLOCKER") is not a directory (a token file shared by every account); profiles will not start until you move it away" ;;
    esac
    d=$(dflt); echo "default: ${d:-none}"
    if [ -f "$AGYX_LINKS_FILE" ]; then echo "symlinks: $AGYX_LINKS_FILE"; else echo "symlinks: $AGYX_LINKS_FILE (missing and could not be written: built-in default list in use)"; fi
    for n in $(names); do
      p=$data/profiles/$n
      t=$p/$tok
      echo "profile $n: $(status "$n"), home $(ls -ld "$p/home" | cut -c1-10)$([ -f "$t" ] && echo ", token $(ls -l "$t" | cut -c1-10)"), $(kcstate "$n")"
      # shellcheck disable=SC2034 # used by the functions in sync.sh
      P=$p/home
      agyx_report
    done
    dup_warning
    ;;
esac

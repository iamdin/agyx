#!/bin/sh
# agyx: manage agy profiles (setup, doctor, shim, unshim, profile);
# any other invocation launches agy through the shim. See README.md.
die() { echo "agyx: $*" >&2; exit 1; }
valid() {
  case $1 in *'
'*) return 1 ;; esac
  printf %s "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$'
}
# find our own real location (follow symlinks, e.g. Homebrew's bin link) to locate the packaged shim
self=$0
while [ -L "$self" ]; do
  l=$(readlink "$self")
  case $l in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
me=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")
shim=$(dirname "$me")/agy
# Anything that is not one of our own subcommands launches agy (none of them overlaps with an
# agy subcommand or flag, including -h/--help). umask is untouched so agy inherits the caller's.
case ${1-} in
  setup|doctor|shim|unshim|profile) ;;
  *) exec "$shim" "$@" ;;
esac
rh=${AGYX_REAL_HOME:-$(eval "printf %s ~$(id -un)")}
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
tok=home/.gemini/antigravity-cli/antigravity-oauth-token
sec=${AGYX_SECURITY:-/usr/bin/security}  # AGYX_SECURITY is only for tests

need() {
  valid "${1-}" || bad "invalid profile name: ${1-}"
  case $1 in setup|doctor|shim|unshim|profile) bad "profile name is reserved: $1" ;; esac
}
exists() { need "${1-}"; [ -d "$data/profiles/$1/home" ] || bad "no such profile: $1"; }
names() { for d in "$data"/profiles/*/; do [ -d "$d" ] && basename "$d"; done; }
dflt() { [ -f "$data/default" ] && cat "$data/default"; }
# Email of a profile: the id_token_email field of the token file (the only field ever read from
# it, never access/refresh tokens); else the last email= on an applyAuthResult line of the newest
# agy log file. Empty when neither is available.
email_of() {
  e=
  [ -f "$data/profiles/$1/$tok" ] &&
    e=$(plutil -extract id_token_email raw -o - "$data/profiles/$1/$tok" 2>/dev/null | tr -d '[:cntrl:]')
  case $e in ''|*[[:space:]]*)
    ld=$data/profiles/$1/home/.gemini/antigravity-cli/log
    lf=$(ls -t "$ld" 2>/dev/null | head -n 1)
    e=
    [ -n "$lf" ] && [ -f "$ld/$lf" ] &&
      e=$(grep applyAuthResult "$ld/$lf" 2>/dev/null | sed -n 's/.*email=\([^][ ,;"}()]*\).*/\1/p' | tail -n 1 | tr -d '[:cntrl:]')
    ;;
  esac
  case $e in *[[:space:]]*) e= ;; esac
  printf '%s' "$e"
}
# Does the profile keychain hold agy's login item? Never asks for the secret (no -w / -g).
kc_has_item() {
  _kc=$data/profiles/$1/home/Library/Keychains/login.keychain-db
  [ -e "$_kc" ] || return 1
  HOME=$data/profiles/$1/home "$sec" find-generic-password -s gemini -a antigravity "$_kc" >/dev/null 2>&1
}
status() {
  if [ ! -f "$data/profiles/$1/$tok" ] && ! kc_has_item "$1"; then echo "not logged in"; return 0; fi
  e=$(email_of "$1")
  echo "${e:-logged in, email unknown}"
}
kcstate() {
  kc=$data/profiles/$1/home/Library/Keychains/login.keychain-db
  [ -e "$kc" ] || { echo "keychain missing (created on next launch)"; return 0; }
  kd=$(HOME=$data/profiles/$1/home "$sec" default-keychain -d user 2>/dev/null | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
  if [ "$kd" = "$kc" ]; then echo "keychain ok (default for this profile)"; else echo "keychain NOT the default for this profile (found: ${kd:-none})"; fi
}
dup_warning() {
  for n in $(names); do e=$(email_of "$n"); [ -n "$e" ] && echo "$e $n"; done | awk '
    { c[$1]++; p[$1] = p[$1] " " $2 }
    END { for (e in c) if (c[e] > 1) print "WARNING: profiles" p[e] " are logged in to the same Google account (" e ")" }'
}

isshim() { [ -L "$1" ] && [ "$1" -ef "$shim" ]; }
usage="usage: agyx setup [path]            record the official agy (default: first agy in PATH)
       agyx profile login NAME      create profile NAME and log in with agy's native login
       agyx profile default [NAME]  show or set the default profile
       agyx profile list            list profiles and their Google accounts
       agyx doctor                  check the installation
       agyx shim | unshim           enable / disable the optional bare 'agy' takeover
       agyx [--profile NAME] [agy args...]   anything else launches agy"
bad() { echo "agyx: $*" >&2; echo "$usage" >&2; exit 2; }

cmd=${1-}; [ $# -gt 0 ] && shift
case $cmd in
  setup)
    [ $# -le 1 ] || bad "setup takes at most one argument"
    t=${1-}
    if [ -z "$t" ]; then
      IFS=:
      for p in $PATH; do
        if [ -n "$p" ] && [ -f "$p/agy" ] && [ -x "$p/agy" ] && [ ! "$p/agy" -ef "$shim" ]; then t=$p/agy; break; fi
      done
      unset IFS
    fi
    [ -n "$t" ] || die "no agy found in PATH; pass its path"
    case $t in /*) ;; *) t=$PWD/$t ;; esac
    [ -x "$t" ] || bad "not executable: $t"
    [ ! "$t" -ef "$shim" ] || bad "that is the shim itself"
    (umask 077; mkdir -p "$data") && ln -sfn "$t" "$data/real-agy" || die "cannot write $data"
    # shellcheck source=../runtime/sync.sh
    . "$(dirname "$me")/../runtime/sync.sh"
    # shellcheck disable=SC2034 # used by the functions in sync.sh
    R=$rh
    agyx_set_links_file
    if [ ! -e "$AGYX_LINKS_FILE" ]; then
      mkdir -p "${AGYX_LINKS_FILE%/*}" || die "cannot create ${AGYX_LINKS_FILE%/*}"
      { echo "# Names in your real home that agyx links into every profile home (one per line, # = comment)."
        echo "# Not allowed: ., .., names with a slash, .gemini, Library, .local."
        printf '%s\n' $AGYX_DEFAULT_LINKS; } > "$AGYX_LINKS_FILE"
      echo "wrote $AGYX_LINKS_FILE (edit it to change what profiles share)"
    fi
    echo "real agy: $t"
    echo "agyx launches it: 'agyx --profile NAME ...' (make sure agyx itself is on PATH)."
    echo "optional: 'agyx shim' also takes over the bare 'agy' name"
    ;;
  shim)
    [ $# -eq 0 ] || bad "shim takes no arguments"
    l=$data/bin/agy
    if [ -e "$l" ] || [ -L "$l" ]; then isshim "$l" || die "$l exists and is not a link to the shim; not touching it"; fi
    mkdir -p "$data/bin" && ln -sfn "$shim" "$l" || die "cannot write $l"
    echo "bare 'agy' now runs the shim: $l -> $shim"
    r=$(readlink "$data/real-agy" 2>/dev/null)
    echo "$data/bin must come BEFORE the directory of the real agy${r:+ ($(dirname "$r"))} in PATH."
    echo "put this line at the END of your shell config (after anything that adds the real agy's directory):"
    echo "  export PATH=\"$data/bin:\$PATH\""
    ;;
  unshim)
    [ $# -eq 0 ] || bad "unshim takes no arguments"
    l=$data/bin/agy
    if [ -e "$l" ] || [ -L "$l" ]; then
      isshim "$l" || die "$l is not a link to the shim; not removing it"
      rm "$l" || die "cannot remove $l"
    fi
    echo "bare 'agy' is no longer taken over (agyx still works)"
    ;;
  profile)
    sub=${1-}; [ $# -gt 0 ] && shift
    case $sub in
      login)
        [ $# -eq 1 ] || bad "profile login needs exactly one profile name"
        need "${1-}"
        (umask 077; mkdir -p "$data/profiles/$1/home") || die "cannot create profile"
        exec "$shim" --profile "$1"
        ;;
      default)
        [ $# -le 1 ] || bad "profile default takes at most one profile name"
        if [ $# -eq 0 ]; then d=$(dflt); echo "${d:-none}"; exit 0; fi
        exists "$1"
        printf '%s\n' "$1" > "$data/default"
        ;;
      list)
        [ $# -eq 0 ] || bad "profile list takes no arguments"
        if [ -z "$(names)" ]; then echo "no profiles yet; run: agyx profile login NAME"; exit 0; fi
        d=$(dflt)
        for n in $(names); do
          s=$(status "$n"); [ "$n" = "$d" ] && s="$s  (default)"
          printf '%-12s %s\n' "$n" "$s"
        done
        dup_warning
        ;;
      *) bad "profile needs a subcommand: list | login NAME | default [NAME]" ;;
    esac
    ;;
  doctor)
    [ $# -eq 0 ] || bad "doctor takes no arguments"
    real=$data/real-agy
    if [ -x "$real" ]; then
      echo "real agy: $(readlink "$real")"
      echo "version: $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$real" --version 2>&1 | head -n 1)"
    else
      echo "real agy: not set (run: agyx setup)"
    fi
    first=$(command -v agyx)
    if [ -n "$first" ] && [ "$first" -ef "$me" ]; then echo "PATH: agyx resolves to this script ($first)"
    else echo "PATH: agyx does NOT resolve to this script (found: ${first:-none}); put it on PATH (Homebrew does; or link $me)"; fi
    if [ -L "$data/bin/agy" ]; then
      first=$(command -v agy)
      if [ -n "$first" ] && [ "$first" -ef "$shim" ]; then echo "takeover: on, agy resolves to the shim ($first)"
      else echo "takeover: WARNING agy link exists but 'agy' resolves to ${first:-nothing}; put $data/bin before the real agy's directory in PATH"; fi
    else
      echo "takeover: off. Inside an agent shell a nested 'agyx' routes to the inherited profile, but a nested bare 'agy' runs the real agy with the real HOME (default login, not the instance profile); use 'agyx shim' to enable"
    fi
    kd=$(HOME=$rh "$sec" default-keychain -d user 2>/dev/null | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
    case $kd in
      "$data"/*) echo "keychain: WARNING the real default keychain is inside the agyx data dir ($kd)" ;;
      *) echo "keychain: real default keychain is ${kd:-unknown}, outside the agyx data dir" ;;
    esac
    d=$(dflt); echo "default: ${d:-none}"
    # shellcheck source=../runtime/sync.sh
    . "$(dirname "$me")/../runtime/sync.sh"
    # shellcheck disable=SC2034 # used by the functions in sync.sh
    R=$rh
    agyx_set_links_file
    if [ -f "$AGYX_LINKS_FILE" ]; then echo "symlinks: $AGYX_LINKS_FILE"; else echo "symlinks: $AGYX_LINKS_FILE (missing: built-in default list in use; 'agyx setup' writes the file)"; fi
    for n in $(names); do
      p=$data/profiles/$n
      t=$p/$tok
      echo "profile $n: $(status "$n"), home $(ls -ld "$p/home" | cut -c1-10)$([ -f "$t" ] && echo ", token $(ls -l "$t" | cut -c1-10)"), $(kcstate "$n")"
      # shellcheck disable=SC2034 # used by the functions in sync.sh
      P=$p/home
      agyx_report
    done
    dup_warning
    ;;
esac

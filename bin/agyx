#!/bin/sh
# shellcheck disable=SC3013 # -ef/-nt are POSIX.1-2024 ( omitted only in older ShellCheck < 0.10 )
# agyx: manage agy profiles (profile, doctor, uninstall); any other invocation launches agy
# through the shim. There is no setup step: everything else is automatic. See README.md.
die() { echo "agyx: $*" >&2; exit 1; }

# find our own real location (follow symlinks, bounded, zero dirname/basename forks)
self=$0 _hops=0
while [ -L "$self" ]; do
  _hops=$((_hops + 1)); [ "$_hops" -le 40 ] || die "symlink loop: $0"
  l=$(readlink "$self") || die "cannot read symlink: $self"
  case $l in
    /*) self=$l ;;
    *) case $self in */*) self=${self%/*}/$l ;; *) self=$l ;; esac ;;
  esac
done
case $self in */*) _sdir=${self%/*}; _sbase=${self##*/} ;; *) _sdir=.; _sbase=$self ;; esac
_pdir=$(cd "${_sdir:-/}" && pwd -P) || die "cannot resolve script directory"
me=${_pdir%/}/$_sbase
shim=${me%/*}/agy
runtime=$(cd "${_pdir%/}/../runtime" && pwd -P) || die "cannot resolve runtime directory"
rh=$HOME
unset AGYX_REAL_HOME AGY_PROFILE
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
# shellcheck disable=SC2034 # R, AGYX_SHIM and AGYX_RUNTIME are used by sync.sh
R=$rh AGYX_SHIM=$shim AGYX_RUNTIME=$runtime
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
agyx_stable "$shim"
# shellcheck disable=SC2034 # used by the functions in sync.sh
AGYX_SHIM=$AGYX_STABLE # the entry link must survive a Homebrew upgrade

usage="usage: agyx [--profile NAME] [agy args...]   launch agy as a profile
       agyx profile login NAME      create profile NAME and sign in with agy's own login
       agyx profile default [NAME]  show or set the default profile
       agyx profile list            list profiles and their Google accounts
       agyx profile usage [NAME]    show that profile's quota (default profile if omitted)
       agyx setup t3code [-y|--yes] sync profiles into T3 Code settings.json
       agyx doctor                  check the installation
       agyx uninstall               remove agyx's data and configuration
       any other arguments go to agy; agy's own help: agyx --profile NAME --help"

# Help and version are strictly read-only: never touch disk.
if [ $# -eq 1 ]; then
  case $1 in --help|-h|help) echo "$usage"; exit 0 ;; esac
fi
if [ "${1-}" = --version ]; then
  echo "agyx $AGYX_VERSION"
  # shellcheck disable=SC2154 # real is set by agyx_find_real
  agyx_find_real && _r=$real || _r=''
  [ -n "$_r" ] && [ -x "$_r" ] && echo "agy $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$_r" --version 2>&1 | head -n 1)"
  exit 0
fi

# Anything that is not one of our own subcommands launches agy via the shim.
if ! agyx_subcommand "${1-}"; then
  unset AGYX_RUNTIME
  exec "$shim" "$@"
fi

tok=antigravity-cli/antigravity-oauth-token
sec=${AGYX_SECURITY:-/usr/bin/security} # AGYX_SECURITY is only for tests
repair() { agyx_ensure_entry || die "cannot prepare app entry"; }
if [ "${1-}" != uninstall ] && [ -d "$data" ]; then
  repair
fi
notyet() { echo "agyx is not set up yet; run agyx once in a terminal to set it up (or set AGYX_ASSUME_YES=1)"; exit 0; }

need() {
  agyx_valid_name "${1-}" || bad "invalid profile name: ${1-}"
  ! agyx_subcommand "$1" || bad "profile name is reserved: $1"
}
exists() { need "${1-}"; [ -d "$data/profiles/$1/antigravity-cli" ] || bad "no such profile: $1"; }
names() { for d in "$data"/profiles/*/; do [ -d "$d" ] && basename "$d"; done; }
dflt() { [ -f "$data/default" ] && cat "$data/default"; }
# Saved email only: never open the token, even for metadata.
email_of() {
  e=''
  [ ! -f "$data/profiles/$1/email" ] || IFS= read -r e < "$data/profiles/$1/email"
  case $e in *[[:space:]]*) e='' ;; esac
  printf '%s' "$e"
}
logged_in() { [ -f "$data/profiles/$1/$tok" ] && [ ! -L "$data/profiles/$1/$tok" ]; }
status() {
  if ! logged_in "$1"; then echo "not logged in"; return 0; fi
  e=$(email_of "$1")
  echo "${e:-logged in, email unknown}"
}
dup_warning() {
  for n in $(names); do logged_in "$n" || continue; e=$(email_of "$n"); [ -n "$e" ] && echo "$e $n"; done | awk '
    { c[$1]++; p[$1] = p[$1] " " $2 }
    END { for (e in c) if (c[e] > 1) print "WARNING: profiles" p[e] " are logged in to the same Google account (" e ")" }'
}

bad() { echo "agyx: $*" >&2; echo "$usage" >&2; exit 2; }

cmd=${1-}; [ $# -gt 0 ] && shift
case $cmd in
  profile)
    sub=${1-}; [ $# -gt 0 ] && shift
    case $sub in
      login)
        [ $# -eq 1 ] || bad "profile login needs exactly one profile name"
        need "${1-}"
        agyx_gate; repair
        [ ! -L "$data/profiles/$1" ] && [ ! -L "$data/profiles/$1/antigravity-cli" ] || die "profile must not be a symlink"
        (umask 077; mkdir -p "$data/profiles/$1/antigravity-cli") || die "cannot create profile"
        if logged_in "$1"; then
          echo "agyx: profile '$1' is already logged in ($(status "$1")). Starting agy in it anyway; sign in again from there only if you want to change the account." >&2
        fi
        login_log=$(mktemp "${TMPDIR:-/tmp}/agyx-login-XXXXXX") || die "cannot create temporary login log"
        trap : INT
        (unset AGYX_RUNTIME; "$shim" --profile "$1" --log-file "$login_log"); rc=$?
        trap - INT
        [ ! -s "$login_log" ] || agyx_check_storage "$login_log"
        if logged_in "$1"; then
          e=$(agyx_email_file "$login_log")
          if [ -n "$e" ]; then printf '%s\n' "$e" > "$data/profiles/$1/email"
          else rm -f "$data/profiles/$1/email"; fi
        fi
        rm -f "$login_log"
        if logged_in "$1" && [ -z "$(dflt)" ]; then
          printf '%s\n' "$1" > "$data/default" &&
            echo "agyx: '$1' is now the default profile (change it with: agyx profile default NAME)"
        fi
        exit "$rc"
        ;;
      default)
        [ $# -le 1 ] || bad "profile default takes at most one profile name"
        if [ $# -eq 0 ]; then [ -d "$data" ] || notyet; d=$(dflt); echo "${d:-none}"; exit 0; fi
        need "$1"; agyx_gate; repair; exists "$1"
        printf '%s\n' "$1" > "$data/default"
        ;;
      list)
        [ $# -eq 0 ] || bad "profile list takes no arguments"
        [ -d "$data" ] || notyet
        if [ -z "$(names)" ]; then echo "no profiles yet; run: agyx profile login NAME"; exit 0; fi
        d=$(dflt)
        for n in $(names); do
          s=$(status "$n"); [ "$n" = "$d" ] && s="$s  (default)"
          printf '%-12s %s\n' "$n" "$s"
        done
        dup_warning
        ;;
      usage)
        [ $# -le 1 ] || bad "profile usage takes at most one profile name"
        if [ $# -eq 1 ]; then exists "$1"; set -- --profile "$1"; else set --; fi
        unset AGYX_RUNTIME
        exec "$shim" "$@" -p /usage
        ;;
      *) bad "profile needs a subcommand: list | login NAME | default [NAME] | usage [NAME]" ;;
    esac
    ;;
  uninstall)
    [ $# -eq 0 ] || bad "uninstall takes no arguments"
    if [ "${AGYX_ASSUME_YES-}" != 1 ] && ! agyx_has_tty; then
      die "uninstall needs a terminal to ask (or set AGYX_ASSUME_YES=1); nothing was removed."
    fi
    # Only check open files inside agyx's own data/profile paths (never block plain native agy).
    set -- "$data/agy"
    for d in "$data"/profiles/*/antigravity-cli; do
      [ -d "$d" ] || continue
      set -- "$@" "$d" "$d/conversation_summaries.db"
      for lg in "$d"/log/*.log; do [ -f "$lg" ] && set -- "$@" "$lg"; done
    done
    pids=$(agyx_open_pids "$@")
    if [ -n "$pids" ]; then
      die "agy is still running (PIDs: ${pids% }). Close it first, then run agyx uninstall again; nothing was removed."
    fi
    pl=''; for n in $(names); do pl="$pl${pl:+, }$n"; done
    kind=other
    prefix=${me%/*/*}
    case $me in */Cellar/*/*) formula=${me#*/Cellar/}; formula=${formula%%/*}; kind=brew ;;
      *)
        if [ -e "$prefix/.git" ]; then kind=checkout
        elif [ -f "$prefix/.agyx-prefix" ]; then kind=prefix
        fi ;;
    esac
    plink=$rh/.local/bin/agyx
    case $kind in
      checkout|prefix) [ -L "$plink" ] && [ "$plink" -ef "$me" ] || plink= ;;
    esac
    {
      echo "agyx uninstall will remove:"
      [ -d "$data" ] && echo "  $(agyx_tilde "$data")/   profiles ${pl:-none} (private app files, logins and logs; moved to Trash)"
      case $kind in
        brew) echo "  agyx itself   (brew uninstall $formula)" ;;
        checkout) if [ -n "$plink" ]; then echo "  agyx itself   (the link $(agyx_tilde "$plink"))"; else echo "  agyx itself   (nothing: it runs from a checkout, which is left alone)"; fi ;;
        prefix)
          echo "  agyx itself   (the install $(agyx_tilde "$prefix"))"
          [ -z "$plink" ] || echo "  $(agyx_tilde "$plink")   PATH link"
          ;;
        *) echo "  agyx itself   (delete $(agyx_tilde "$me") yourself)" ;;
      esac
      echo "Kept: ~/.gemini (shared settings, history and conversations) and plain agy."
      [ -d "$data" ] && echo "Apps set up with $(agyx_tilde "$data")/agy (for example T3 Code) will stop working."
    } >&2
    agyx_ask n 'Remove? [y/N] ' || { echo >&2; die "nothing was removed."; }
    tbase=$(agyx_trash_base)
    (umask 077; mkdir -p "$tbase") || die "cannot create Trash directory"
    trash=$(mktemp -d "$tbase/agyx-uninstall-$(date +%Y%m%d%H%M%S)-XXXXXX") || die "cannot create uninstall Trash directory"
    [ ! -d "$data" ] || mv "$data" "$trash/data" || die "could not move $data to the Trash"
    echo "agyx: removed. Moved to the Trash: $(agyx_tilde "$trash")"
    case $kind in
      brew)
        echo "agyx: removing the program now (optionally afterwards: brew untap iamdin/tap)"
        exec brew uninstall "$formula" ;;
      checkout)
        if [ -n "$plink" ]; then rm -f "$plink" && echo "agyx: removed the link $(agyx_tilde "$plink") (the checkout is left alone)"
        else echo "agyx: nothing else to remove (agyx runs from a checkout, which is left alone)"; fi ;;
      prefix)
        [ -z "$plink" ] || rm -f "$plink"
        rm -rf "$prefix"
        echo "agyx: removed the install $(agyx_tilde "$prefix")${plink:+ and $(agyx_tilde "$plink")}"
        ;;
      *) echo "agyx: to finish, delete $me yourself" ;;
    esac
    ;;
  setup)
    sub=${1-}; [ $# -gt 0 ] && shift
    case $sub in
      t3code)
        yes=0
        while [ $# -gt 0 ]; do
          case $1 in
            -y|--yes) yes=1; shift ;;
            -h|--help) echo "usage: agyx setup t3code [-y|--yes]

Interactive (default): show the plan and ask before writing ~/.t3/userdata/settings.json.
Non-interactive: pass -y/--yes, or set AGYX_ASSUME_YES=1 (required when there is no TTY).

Requires an existing, valid T3 Code settings.json (open T3 Code once first).
Each profile becomes providerInstances.agy_<name> with binaryPath=<agyx entry>
and AGYX_PROFILE=<name>. Other providers are kept; stale agyx instances are removed."; exit 0 ;;
            *) bad "setup t3code: unknown argument: $1 (use -y/--yes)" ;;
          esac
        done
        [ -d "$data" ] || notyet
        pl=$(names)
        [ -n "$pl" ] || die "no profiles yet; run: agyx profile login NAME"
        agyx_gate; repair
        entry=$data/agy
        [ -e "$entry" ] || die "agy entry missing: $entry (run: agyx doctor)"
        # Absolute path: T3 Code does not expand ~
        entry=$(cd "${entry%/*}" && pwd -P)/${entry##*/} || die "cannot resolve agy entry"
        settings=$rh/.t3/userdata/settings.json
        [ -f "$settings" ] || die "T3 Code settings not found: $(agyx_tilde "$settings") (open T3 Code once so it creates settings.json, then retry)"
        [ ! -L "$settings" ] || die "T3 Code settings must be a regular file, not a symlink: $(agyx_tilde "$settings")"
        command -v python3 >/dev/null 2>&1 || die "setup t3code needs python3 to edit JSON"
        # Validate JSON before prompting or writing.
        python3 - "$settings" <<'PY' || die "T3 Code settings failed validation; nothing was changed"
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
try:
    data = json.loads(p.read_text(encoding="utf-8"))
except json.JSONDecodeError as e:
    sys.stderr.write(f"agyx: invalid JSON in {p}: {e}\n")
    sys.exit(1)
if not isinstance(data, dict):
    sys.stderr.write(f"agyx: {p} must be a JSON object\n")
    sys.exit(1)
inst = data.get("providerInstances")
if inst is not None and not isinstance(inst, dict):
    sys.stderr.write(f"agyx: providerInstances in {p} must be an object\n")
    sys.exit(1)
PY
        echo "agyx will upsert T3 Code Antigravity instances for profiles:$pl" >&2
        echo "  settings: $(agyx_tilde "$settings")" >&2
        echo "  binaryPath: $entry" >&2
        echo "  each instance: AGYX_PROFILE=<name>  id=agy_<name>" >&2
        if [ "$yes" = 1 ] || [ "${AGYX_ASSUME_YES-}" = 1 ]; then
          :
        elif agyx_has_tty; then
          agyx_ask y 'Update T3 Code settings? [Y/n] ' || { echo >&2; die "nothing was changed."; }
        else
          die "setup t3code needs a terminal to ask, or run non-interactively: agyx setup t3code -y (or AGYX_ASSUME_YES=1); nothing was changed."
        fi
        # shellcheck disable=SC2086 # $pl is a validated profile-name list from names()
        python3 - "$settings" "$entry" $pl <<'PY' || die "failed to update T3 Code settings"
import json, os, sys, tempfile
from pathlib import Path

settings_path = Path(sys.argv[1])
entry = sys.argv[2]
profiles = sys.argv[3:]
wanted = {f"agy_{name}": name for name in profiles}

if not settings_path.is_file() or settings_path.is_symlink():
    sys.stderr.write(f"agyx: T3 Code settings missing or not a regular file: {settings_path}\n")
    sys.exit(1)
try:
    data = json.loads(settings_path.read_text(encoding="utf-8"))
except json.JSONDecodeError as e:
    sys.stderr.write(f"agyx: invalid JSON in {settings_path}: {e}\n")
    sys.exit(1)
if not isinstance(data, dict):
    sys.stderr.write(f"agyx: {settings_path} must be a JSON object\n")
    sys.exit(1)

instances = data.get("providerInstances")
if instances is None:
    instances = {}
elif not isinstance(instances, dict):
    sys.stderr.write(f"agyx: providerInstances in {settings_path} must be an object\n")
    sys.exit(1)

def is_agyx_managed(iid, inst):
    if not isinstance(inst, dict):
        return False
    if iid in wanted:
        return True
    if inst.get("driver") != "antigravity":
        return False
    cfg = inst.get("config") or {}
    if not isinstance(cfg, dict) or cfg.get("binaryPath") != entry:
        return False
    env = inst.get("environment") or []
    if not isinstance(env, list):
        return False
    for item in env:
        if isinstance(item, dict) and item.get("name") == "AGYX_PROFILE":
            return True
    return False

removed = []
for iid, inst in list(instances.items()):
    if is_agyx_managed(iid, inst) and iid not in wanted:
        del instances[iid]
        removed.append(iid)

upserted = []
for iid, name in wanted.items():
    instances[iid] = {
        "driver": "antigravity",
        "displayName": f"agy {name}",
        "environment": [
            {"name": "AGYX_PROFILE", "value": name, "sensitive": False}
        ],
        "enabled": True,
        "config": {"binaryPath": entry},
    }
    upserted.append(iid)

data["providerInstances"] = instances
text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
fd, tmp = tempfile.mkstemp(prefix="agyx-t3code-", suffix=".json", dir=str(settings_path.parent))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, settings_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise

print(f"agyx: updated {settings_path}")
print(f"  upserted: {', '.join(upserted) if upserted else '(none)'}")
if removed:
    print(f"  removed:  {', '.join(removed)}")
print("  restart T3 Code to reload providers")
PY
        ;;
      *) bad "setup needs a subcommand: t3code" ;;
    esac
    ;;
  doctor)
    [ $# -eq 0 ] || bad "doctor takes no arguments"
    echo "agyx version: $AGYX_VERSION"
    [ -d "$data" ] || notyet
    # shellcheck disable=SC2154 # real is set by agyx_find_real
    if agyx_find_real; then
      echo "real agy: $real${AGYX_REAL_AGY:+ (from AGYX_REAL_AGY)}"
      echo "version: $(AGY_CLI_DISABLE_AUTO_UPDATE=true "$real" --version 2>&1 | head -n 1)"
      agyx_check_binary "$real"
    else
      echo "real agy: NOT FOUND. Install agy, or point agyx at it with AGYX_REAL_AGY=/path/to/agy"
    fi
    first=$(command -v agyx)
    if [ -n "$first" ] && [ "$first" -ef "$me" ]; then echo "PATH: agyx resolves to this script ($first)"
    else echo "PATH: agyx does NOT resolve to this script (found: ${first:-none}); put it on PATH (Homebrew does; or link $me)"; fi
    if [ -e "$data/agy" ] && [ "$data/agy" -ef "$shim" ]; then
      echo "agy entry: $data/agy (in place; the path to give apps that need a binary named agy)"
    else
      echo "agy entry: $data/agy is MISSING or not agyx's (it is the path to give apps that need a binary named agy)"
    fi
    if agyx_native_file_storage; then
      echo "profile mode: real HOME; native file storage (no shell bridge needed); --app_data_dir=<profile>/antigravity-cli (relative to ~/.gemini)"
    else
      echo "profile mode: real HOME; WSL_INTEROP=${WSL_INTEROP:-agyx} (desktop keyring bypass + shell bridge); --app_data_dir=<profile>/antigravity-cli (relative to ~/.gemini)"
    fi
    if [ -x "$sec" ] && HOME=$rh "$sec" find-generic-password -s gemini -a antigravity >/dev/null 2>&1; then
      echo "keychain: INFO plain agy has a login (gemini/antigravity); agyx does not use it"
    fi
    d=$(dflt); echo "default: ${d:-none}"
    for n in $(names); do
      p=$data/profiles/$n
      t=$p/$tok
      echo "profile $n: $(status "$n")"
      for dir in "$p" "$p/antigravity-cli"; do
        if [ -d "$dir" ]; then
          mode=$(agyx_mode "$dir")
          [ $((0$mode & 077)) -eq 0 ] || echo "  permissions: WARNING $dir mode $mode is group/world accessible (expected 0700)"
        else echo "  permissions: WARNING directory missing: $dir"; fi
      done
      if [ -L "$t" ]; then echo "  token: WARNING symlink (profile will not start)"
      elif [ -f "$t" ]; then
        mode=$(agyx_mode "$t")
        if [ "$mode" = 600 ]; then echo "  token: present, mode 0600"
        else echo "  token: WARNING mode $mode (expected 0600)"; fi
      else echo "  token: missing (sign in again)"; fi
      # shellcheck disable=SC2034 # P is used by sync.sh
      P=$p/antigravity-cli
      agyx_report
      nl=$(ls -t "$P"/log/*.log 2>/dev/null | head -n 1)
      [ -z "$nl" ] || agyx_check_storage "$nl"
      nl=${nl##*/}
      echo "  logs: $(agyx_tilde "$P/log")/, newest: ${nl:-none yet}"
    done
    dup_warning
    ;;
esac

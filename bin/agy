#!/bin/sh
# agyx shim: run the real agy under a per-profile HOME.
die() { echo "agyx: $*" >&2; exit 2; }
valid() {
  case $1 in *'
'*) return 1 ;; esac
  printf %s "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$'
}

# find our own real location (follow symlinks) so runtime/ is found wherever we are installed
self=$0
while [ -L "$self" ]; do
  l=$(readlink "$self")
  case $l in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
self=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")
runtime=$(cd "$(dirname "$self")/../runtime" && pwd -P)
rh=${AGYX_REAL_HOME:-$(eval "printf %s ~$(id -un)")}
data=${AGYX_DATA_DIR:-$rh/.local/share/agyx}
# shellcheck disable=SC2034 # R, AGYX_SHIM and data are used by the functions in sync.sh
R=$rh AGYX_SHIM=$self
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
# what we store or pass on (entry link, ZDOTDIR, BASH_ENV) must survive a Homebrew upgrade
agyx_stable "$self"; AGYX_SHIM=$AGYX_STABLE
runtime_stable=${AGYX_SHIM%/*/*}/runtime
# ask once before the first write; then automatic repairs (stderr only, never stdout)
agyx_gate
agyx_ensure_entry
agyx_ensure_links_file

# 1. profile choice: leading --profile flags only
flag=0 name='' src=''
while [ $# -gt 0 ]; do
  case $1 in
    --profile)
      [ $# -ge 2 ] || die "--profile needs a value"
      v=$2; shift 2 ;;
    --profile=*) v=${1#--profile=}; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
  [ "$flag" = 0 ] || die "--profile given more than once"
  [ -n "$v" ] || die "--profile value is empty"
  flag=1 name=$v
done
if [ "$flag" = 0 ]; then
  name=${AGY_PROFILE:-}
  [ -z "$name" ] || src='env'
  if [ -z "$name" ] && [ -f "$data/default" ]; then
    read -r name < "$data/default" || :
    [ -z "$name" ] || src='default'
  fi
  if [ -z "$name" ]; then
    # first-run messages (error path only, forks are fine)
    existing=
    for d in "$data"/profiles/*/; do [ -d "$d" ] && existing="$existing $(basename "$d")"; done
    if [ -z "$existing" ]; then
      die "no profiles yet. Create and sign in to one with: agyx profile login NAME (for example: agyx profile login work)"
    fi
    die "no profile chosen. Existing profiles:$existing. Pick one with --profile NAME, or set a default with: agyx profile default NAME"
  fi
fi
valid "$name" || die "invalid profile name: $name"
agyx_subcommand "$name" && die "profile name is reserved: $name"
phome=$data/profiles/$name/home
if [ ! -d "$phome" ]; then
  if [ "$src" = default ]; then
    die "the default profile '$name' (from $data/default) does not exist. Fix it with: agyx profile default NAME, or create it with: agyx profile login $name"
  fi
  die "profile '$name' does not exist (run: agyx profile login $name)"
fi

# 3. real binary
agyx_find_real || agyx_missing_agy

# 3a. the shared ~/.gemini must not be able to hold a token file (see runtime/sync.sh)
agyx_ensure_blocker || exit 1

# 3b. give the profile HOME its own empty, unlocked keychain, so agy's /usr/bin/security calls
# succeed silently instead of showing "Keychain Not Found". Every security call sets HOME to the
# profile home and names the keychain explicitly: the real keychain is never touched.
# AGYX_SECURITY is only for tests.
sec=${AGYX_SECURITY:-/usr/bin/security}
ensure_keychain() {
  kc=$phome/Library/Keychains/login.keychain-db
  [ ! -e "$kc" ] || return 0
  ( umask 077; mkdir -p "$phome/Library/Keychains" ) &&
  (
    HOME=$phome; export HOME
    "$sec" create-keychain -p "" "$kc" &&
    "$sec" list-keychains -d user -s "$kc" &&
    "$sec" default-keychain -d user -s "$kc" &&
    "$sec" set-keychain-settings "$kc"
  ) >/dev/null </dev/null || {
    rm -f "$kc"
    echo "agyx: warning: could not create the profile keychain; agy may not be able to save its login" >&2
  }
  return 0
}
ensure_keychain

# 3c. the shared .gemini link and the home whitelist (symlinks only; see runtime/sync.sh)
# shellcheck disable=SC2034 # used by the functions in sync.sh
P=$phome
agyx_sync_gemini "$name"
agyx_sync_home

# 4. environment (originals saved unless the caller already points at the bridge)
bz=$runtime_stable/zsh bb=$runtime_stable/bash_env
if [ "${ZDOTDIR-}" != "$bz" ]; then
  if [ "${ZDOTDIR+x}" ]; then AGYX_ORIG_ZDOTDIR_SET=1 AGYX_ORIG_ZDOTDIR=$ZDOTDIR
  else AGYX_ORIG_ZDOTDIR_SET=0 AGYX_ORIG_ZDOTDIR=; fi
fi
if [ "${BASH_ENV-}" != "$bb" ]; then
  if [ "${BASH_ENV+x}" ]; then AGYX_ORIG_BASH_ENV_SET=1 AGYX_ORIG_BASH_ENV=$BASH_ENV
  else AGYX_ORIG_BASH_ENV_SET=0 AGYX_ORIG_BASH_ENV=; fi
fi
HOME=$phome AGY_PROFILE=$name AGYX_REAL_HOME=$rh AGY_CLI_DISABLE_AUTO_UPDATE=true
ZDOTDIR=$bz BASH_ENV=$bb
export HOME AGY_PROFILE AGYX_REAL_HOME AGY_CLI_DISABLE_AUTO_UPDATE ZDOTDIR BASH_ENV \
  AGYX_ORIG_ZDOTDIR_SET AGYX_ORIG_ZDOTDIR AGYX_ORIG_BASH_ENV_SET AGYX_ORIG_BASH_ENV
# shellcheck disable=SC2154 # real is set by agyx_find_real
exec "$real" "$@"

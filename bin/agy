#!/bin/sh
# agyx shim: run agy with real HOME and a private file login.
die() { echo "agyx: $*" >&2; exit 1; }
usage_err() { echo "agyx: $*" >&2; exit 2; }
missing_err() { echo "agyx: $*" >&2; exit 3; }

# find our own real location (follow symlinks, bounded, zero dirname/basename forks)
self=$0 _hops=0
while [ -L "$self" ]; do
  _hops=$((_hops + 1)); [ "$_hops" -le 40 ] || die "symlink loop: $0"
  l=$(readlink "$self") || die "cannot read symlink: $self"
  case $l in
    /*) self=$l ;;
    *) case $self in */*) self=${self%/*}/$l ;; *) self=$l ;; esac ;;
  esac
done
case $self in */*) _sdir=${self%/*}; _sbase=${self##*/} ;; *) _sdir=.; _sbase=$self ;; esac
_pdir=$(cd "${_sdir:-/}" && pwd -P) || die "cannot resolve script directory"
self=${_pdir%/}/$_sbase
runtime=$(cd "${_pdir%/}/../runtime" && pwd -P) || die "cannot resolve runtime directory"
# shellcheck source=../runtime/sync.sh
. "$runtime/sync.sh"
# what we store or pass on (entry link) must survive a Homebrew upgrade
agyx_init "$self"
# ask once before the first write; then automatic repairs (stderr only, never stdout)
agyx_gate
agyx_ensure_entry || die "cannot prepare app entry"

# 1. profile choice: leading --profile flags only
flag=0 name=''
while [ $# -gt 0 ]; do
  case $1 in
    --profile)
      [ $# -ge 2 ] || usage_err "--profile needs a value"
      v=$2; shift 2 ;;
    --profile=*) v=${1#--profile=}; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
  [ "$flag" = 0 ] || usage_err "--profile given more than once"
  [ -n "$v" ] || usage_err "--profile value is empty"
  flag=1 name=$v
done
if [ "$flag" = 1 ]; then
  agyx_resolve_profile "$name"
else
  agyx_resolve_profile
fi
_rc=$?
if [ "$_rc" -ne 0 ]; then
  case $_rc in
    1) die "$AGYX_ERR_MSG" ;;
    2) usage_err "$AGYX_ERR_MSG" ;;
    *) missing_err "$AGYX_ERR_MSG${AGYX_ERR_HINT:+ ($AGYX_ERR_HINT)}" ;;
  esac
fi
name=$AGYX_PROFILE_NAME
pdir=$AGYX_DATA/profiles/$name/antigravity-cli

# 2. real binary & profile app preparation
agyx_find_real || agyx_missing_agy
for a in "$@"; do
  case $a in --app_data_dir|--app_data_dir=*|-app_data_dir|-app_data_dir=*|--app-data-dir|--app-data-dir=*|-app-data-dir|-app-data-dir=*|--gemini_dir|--gemini_dir=*|-gemini_dir|-gemini_dir=*|--gemini-dir|--gemini-dir=*|-gemini-dir|-gemini-dir=*) usage_err "storage flags are managed by agyx" ;; esac
done
agyx_sync_app "$pdir" || {
  _rc=$?
  [ "$_rc" -eq 5 ] && exit 5
  die "cannot prepare profile app directory"
}
agyx_app_arg "$pdir" || die "cannot resolve profile app directory"

# 3. force profile-local file token storage (agy >= 1.5.16; bypasses OS keyrings on all platforms)
AGYX_PROFILE=$name AGY_CLI_FORCE_FILE_TOKEN_STORAGE=1
export AGYX_PROFILE AGY_CLI_FORCE_FILE_TOKEN_STORAGE

# 4. check newest native log in <profile>/antigravity-cli/log, then direct exec
agyx_check_recent_log "$pdir"
_exec_real=$AGYX_REAL _exec_app=$AGYX_APP_ARG
unset AGYX_RUNTIME AGYX_ASSUME_YES AGYX_TTY AGYX_SECURITY AGYX_TRASH_DIR AGYX_LOCK_TRIES AGYX_OS \
  AGYX_REAL_HOME AGY_PROFILE \
  AGYX_HOME AGYX_DATA AGYX_SHIM AGYX_VERSION AGYX_SHARED_DIRS AGYX_SHARED_FILES \
  AGYX_STABLE AGYX_APP_ARG AGYX_RESOLVED AGYX_REAL \
  AGYX_PROFILE_NAME AGYX_PROFILE_SRC AGYX_ERR_CODE AGYX_ERR_MSG AGYX_ERR_HINT \
  AGYX_DOC_LINE AGYX_DOC_WARN
exec "$_exec_real" "--app_data_dir=$_exec_app" "$@"
